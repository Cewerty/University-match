# Required for `uv run`: bot token from @BotFather.
# In Docker it is ignored: the bot reads the token from secrets/bot_token (see README).
# BOT_TOKEN_FILE=/path/to/file can be used instead of BOT_TOKEN.
BOT_TOKEN=

# Database (local SQLite file by default)
DATABASE_URL=sqlite+aiosqlite:///./database.db

# Address of the FastAPI service the bot queries for matches
BACKEND_URL=http://localhost:8000

# Redis for dialog state; leave empty to keep state in memory (lost on restart)
REDIS_URL=

# Optional: proxy for reaching the Telegram API, e.g. socks5://user:pass@host:1080
TELEGRAM_PROXY_URL=

# Minimum cosine similarity (-1..1) for a match to be shown to the user.
# 0.45 best separates users with and without shared interests on the seed data.
MINIMAL_MATCH_VALUE=0.45

# Multilingual sentence-transformers model for interest embeddings (~460 MB download)
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Optional overrides (defaults shown)
# WEB_HOST=localhost
# WEB_PORT=8000
# LOG_LEVEL=INFO
# SEED_GENERATION_AMOUNT=50
